{
  "name": "@plutocms/nuxt-content",
  "type": "module",
  "version": "0.6.0",
  "description": "Nuxt Content layer for Pluto: edit the Markdown pages of a Nuxt Content site in the Pluto admin",
  "author": "Victor Ribeiro",
  "license": "MIT",
  "homepage": "https://github.com/plutocms/nuxt-content#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/plutocms/nuxt-content.git"
  },
  "bugs": {
    "url": "https://github.com/plutocms/nuxt-content/issues"
  },
  "main": "./nuxt.config.ts",
  "scripts": {
    "postinstall": "nuxt prepare",
    "prettier": "prettier --write .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "nuxi typecheck",
    "test": "vitest run"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@nuxt/content": "^3.16.2",
    "@nuxtjs/mdc": "^0.23.2",
    "@plutocms/pluto": "^0.26.0",
    "@types/sortablejs": "^1.15.9",
    "remark-gfm": "4.0.1",
    "remark-mdc": "3.11.1",
    "remark-parse": "11.0.0",
    "sortablejs": "^1.15.7",
    "unified": "11.0.5",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/ui": "^4.12.0",
    "@types/node": "^24.0.0",
    "@vueuse/nuxt": "^14.4.0",
    "eslint": "^10.12.0",
    "nuxt": "^4.6.1",
    "prettier": "^3.9.10",
    "vitest": "^5.0.5",
    "vue": "3.5.44",
    "vue-router": "5.4.0",
    "vue-tsc": "^3.3.13"
  },
  "trustedDependencies": [
    "@parcel/watcher",
    "@plutocms/pluto",
    "@plutocms/utils",
    "esbuild",
    "unrs-resolver",
    "vue-demi"
  ],
  "publishConfig": {
    "access": "public"
  }
}
