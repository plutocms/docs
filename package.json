{
  "name": "@plutocms/nuxt-content",
  "type": "module",
  "version": "0.3.1",
  "description": "Nuxt Content layer for Pluto: edit the Markdown pages of a Nuxt Content site in the Pluto admin",
  "author": "Victor Ribeiro",
  "license": "MIT",
  "homepage": "https://github.com/plutocms/nuxt-content#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/plutocms/nuxt-content.git"
  },
  "bugs": {
    "url": "https://github.com/plutocms/nuxt-content/issues"
  },
  "main": "./nuxt.config.ts",
  "scripts": {
    "postinstall": "nuxt prepare",
    "prettier": "prettier --write .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "nuxi typecheck",
    "test": "vitest run"
  },
  "dependencies": {
    "@nuxt/content": "^3.16.2",
    "@plutocms/pluto": "^0.20.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/ui": "^4.12.0",
    "@types/node": "^24.0.0",
    "@vueuse/nuxt": "^14.4.0",
    "eslint": "^10.12.0",
    "nuxt": "^4.6.1",
    "prettier": "^3.9.10",
    "vitest": "^5.0.5",
    "vue": "3.5.44",
    "vue-router": "5.4.0",
    "vue-tsc": "^3.3.13",
    "yaml": "^2.9.1"
  },
  "trustedDependencies": [
    "@parcel/watcher",
    "@plutocms/pluto",
    "@plutocms/utils",
    "esbuild",
    "unrs-resolver",
    "vue-demi"
